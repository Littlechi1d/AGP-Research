# Copy this file to .env and replace the blank key with your private API key.
OPENAI_API_KEY=
AGP_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AGP_LLM_TIMEOUT=60
# Set either path to blank to disable that feature.
AGP_LLM_CACHE_DIR=.agp_cache/llm
AGP_LLM_LOG_PATH=.agp_logs/llm_requests.jsonl
